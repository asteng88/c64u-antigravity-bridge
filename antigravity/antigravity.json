{
  "mcpServers": {
    "c64u-bridge": {
      "command": "uv",
      "args": ["run", "c64u-bridge", "mcp"],
      "env": {
        "C64U_HOST": "192.168.1.64",
        "C64U_PORT": "80",
        "KICKASS_JAR": "/usr/local/bin/KickAss.jar",
        "ACME_BIN": "/usr/local/bin/acme",
        "CC65_BIN": "/usr/local/bin/cl65"
      }
    }
  }
}
